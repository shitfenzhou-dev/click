+    def _should_update_param_slot(
+        self,
+        existing_value: t.Any,
+        existing_source: ParameterSource | None,
+        existing_default_explicit: bool,
+        source: ParameterSource,
+    ) -> bool:
+        """Determine whether the current parameter should overwrite the
+        ``ctx.params`` slot for its name.
+
+        Used by :meth:`handle_parse_result` to arbitrate feature-switch
+        groups where multiple parameters target the same variable name.
+
+        :param existing_value: The value already stored in ``ctx.params``
+            for this parameter name, or ``UNSET`` if the slot is empty.
+        :param existing_source: The :class:`ParameterSource` of the
+            option that last wrote the slot, or ``None``.
+        :param existing_default_explicit: Whether the existing slot owner
+            had an explicit ``default`` set at construction time.
+        :param source: The :class:`ParameterSource` produced by the
+            current parameter's :meth:`consume_value`.
+        """
+        slot_empty = existing_value is UNSET
+        more_explicit = existing_source is not None and source < existing_source
+        same_source = existing_source is not None and source == existing_source
+        auto_would_downgrade_explicit = (
+            same_source
+            and source == ParameterSource.DEFAULT
+            and existing_default_explicit
+            and not self._default_explicit
+        )
+        return (
+            slot_empty
+            or more_explicit
+            or (same_source and not auto_would_downgrade_explicit)
+        )
